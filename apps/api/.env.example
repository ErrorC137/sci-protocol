# --- storage -----------------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string (Session pooler, port 5432).
# Unset = in-memory store loaded from data/seed/grants.yaml (fine for local dev and demos).
DATABASE_URL=

# --- LLM: match explanations, form-field mapping, flat-PDF field inference -----
# Unset = deterministic templates (explanations still work; narrative fields get scaffolds).
ANTHROPIC_API_KEY=
SCI_LLM_MODEL=claude-opus-5-5
SCI_EXPLAIN_TOP_K=10

# --- embeddings (1024-d). Unset = local feature-hashing embedder ----------------
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# --- IPFS. Unset = local content-addressed store served at /ipfs/{cid} ----------
PINATA_JWT=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# --- chain ----------------------------------------------------------------------
CHAIN_ID=84532            # 84532 Base Sepolia | 97 BNB testnet | 31337 local anvil
RPC_URL=                  # Alchemy / QuickNode URL (needed for the indexer)
INDEXER_ENABLED=true
INDEXER_INTERVAL=8

# --- ingestion: extra live connectors to run at boot (curated always loads) -------
STARTUP_CONNECTORS=       # e.g. grants_gov,eu_sedia

CORS_ORIGINS=*            # set to your Vercel URL in production
