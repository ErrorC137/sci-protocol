# Backend (FastAPI) base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
# 43113 = Avalanche Fuji (default), 43114 = Avalanche C-Chain, 84532 = Base Sepolia, 97 = BNB testnet, 31337 = local anvil
NEXT_PUBLIC_CHAIN_ID=43113
# Alchemy/QuickNode RPC for that chain (public RPCs rate-limit)
NEXT_PUBLIC_RPC_URL=
# https://cloud.reown.com - without it only injected wallets (MetaMask etc.) are offered
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
